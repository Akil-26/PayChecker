# =============================================================================
# Paychecker — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Paychecker API
VERSION=1.0.0
# APP_DESCRIPTION has a sensible built-in default; override only if you want
# custom OpenAPI docs text.
# APP_DESCRIPTION=Autonomous AI revenue recovery for merchants.

# Environment: production | development | demo | test
# Controls: auth enforcement, docs visibility, clock type, demo endpoints
ENVIRONMENT=development

API_PREFIX=/api
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite):
DATABASE_URL=sqlite:///./paychecker.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/paychecker
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
DB_ECHO=false

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production. Leave blank to bypass auth in development.
API_KEY_SECRET=

# Set to false in development to keep /docs and /redoc accessible
DISABLE_DOCS_IN_PRODUCTION=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Streamlit dashboard
BACKEND_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Leave blank to use the payment simulator (development/test)
# Production: set these to your live Razorpay credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard → Webhooks → your endpoint
RAZORPAY_WEBHOOK_SECRET=

# ── Multi-tenancy ─────────────────────────────────────────────────────────────
DEFAULT_MERCHANT_ID=merch_default
DEFAULT_CURRENCY=INR

# ── Recovery policy ───────────────────────────────────────────────────────────
MAX_AUTOMATIC_RETRIES=2
REPEATED_FAILURE_LIMIT=3
# In minor units (paise). 5000000 = INR 50,000
HIGH_VALUE_ESCALATION_THRESHOLD=5000000
ALLOW_HUMAN_ESCALATION=true

# ── Component implementations ─────────────────────────────────────────────────
# diagnosis_engine_impl: rule_based
# recovery_predictor_impl: deterministic
# action_executor_impl: razorpay (production) | simulator (development)
DIAGNOSIS_ENGINE_IMPL=rule_based
RECOVERY_PREDICTOR_IMPL=deterministic
ACTION_EXECUTOR_IMPL=simulator

# ── Development virtual clock (ignored in production) ────────────────────────
SIMULATION_SEED=20260101
VIRTUAL_CLOCK_START=2026-01-01T13:00:00
VIRTUAL_CLOCK_STATE_PATH=./.paychecker_clock.json
RETRY_LATER_DELAY_MINUTES=15

# ── Expected recovery value overrides (JSON; built-in defaults normally suffice) ──
# Per-ActionType intervention cost, in minor units. Example:
# INTERVENTION_COST_MINOR={"RETRY_NOW": 500, "RETRY_LATER": 2000}
# Per-ActionType friction penalty, in minor units.
# FRICTION_PENALTY_MINOR={"RETRY_NOW": 2000, "RETRY_LATER": 10000}

# ── Simulator probability overrides (JSON; built-in defaults normally suffice) ──
# "FAILURE_REASON:ACTION_TYPE" -> success probability.
# SIMULATOR_SUCCESS_PROBABILITY={"BANK_TIMEOUT:RETRY_NOW": 0.35}
# Probability used for any reason/action pair not listed above.
# SIMULATOR_FALLBACK_PROBABILITY=0.30
